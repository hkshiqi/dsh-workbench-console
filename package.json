{
  "name": "dsh-workbench-console",
  "version": "2.1.0",
  "description": "工作台框架：在侧边栏「工作区」下方提供可扩展的工作台外壳，其他插件通过 API 注册自己的工作台",
  "type": "module",
  "license": "MIT",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "workbench",
    "framework",
    "sidebar"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hkshiqi/dsh-workbench-console.git"
  }
}
